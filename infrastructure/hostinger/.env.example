# Copy to /opt/oddvex/.env on the server (mode 600). Never commit the real file.
# Generate each secret on the server:  openssl rand -hex 32
ODDVEX_DB_PASSWORD=
ODDVEX_JWT_SECRET=
# The address people type, with https and no trailing slash.
ODDVEX_PUBLIC_URL=https://preview.oddvex.com
# Shown on the contact page. Leave empty until the mailbox exists and receives mail.
ODDVEX_CONTACT_EMAIL=
# Comma-separated emails that get the admin role when they sign up.
ODDVEX_ADMIN_EMAILS=
# Local port the reverse proxy forwards to. 3000 is already used on this server.
ODDVEX_WEB_PORT=3410
