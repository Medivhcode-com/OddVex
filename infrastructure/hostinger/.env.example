# /opt/oddvex/.env on the server (mode 600). ops.sh creates it with generated secrets the first
# time it deploys. Never commit the real file. Nobody edits it by hand: ACTION=setenv writes the
# settings below the two secrets, one key at a time, and a deploy makes them take effect.
ODDVEX_DB_PASSWORD=
ODDVEX_JWT_SECRET=
# The address people type, with https and no trailing slash. Not settable with setenv.
ODDVEX_PUBLIC_URL=https://preview.oddvex.com
# Shown on the contact page (decision D-017). It is compiled into the web image when it is built.
# A deploy writes this default when the key is missing or empty.
ODDVEX_CONTACT_EMAIL=support@oddvex.com
# Comma-separated addresses that may hold the administrator role. Listing an address gives nobody
# the role by itself: the API gives it only to an account whose email address is verified. On
# this server the way to get the first administrator is ACTION=admin with EMAIL=<address>, after
# a deploy with the address listed. It sets a new random password for that address and prints it
# once, so nobody who registered the address earlier keeps access.
# Do not list the contact address above or any other published address: this repository is
# public, so it is the first address a stranger would register. Use a personal one.
ODDVEX_ADMIN_EMAILS=
# Optional. Password hashes computed at once (1 to 8; each holds about 64 MiB in the 768 MB API
# container) and the seconds a sign-in waits for a free slot (0 to 30). These are the defaults.
ODDVEX_PASSWORD_HASH_CONCURRENCY=2
ODDVEX_PASSWORD_HASH_WAIT_SECONDS=1.0
# Optional. Days a daily database dump is kept in /opt/oddvex/backups (1 to 99).
ODDVEX_BACKUP_KEEP_DAYS=14
