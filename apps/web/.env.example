# Server-only: where the Next.js server reaches the API.
ODDVEX_API_URL=http://localhost:8000
# Public site origin, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /contact when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Local http only. The session cookie is marked Secure and HSTS is sent whenever NODE_ENV=production.
# Set this to "true" ONLY to run the production build over plain http on your own machine
# (the e2e suite does). Never set it in production: the session cookie would travel unencrypted.
ODDVEX_INSECURE_COOKIES=
