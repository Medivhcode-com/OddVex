# OddVex API configuration. Copy to .env for local development.
# Names and safe development defaults only. Never commit real secrets.

# development | test | production
ODDVEX_ENV=development

# SQLAlchemy URL. SQLite for local work, PostgreSQL elsewhere:
#   postgresql://user:password@host:5432/oddvex
DATABASE_URL=sqlite:///./oddvex_dev.db

# Required in production (32+ characters). The app refuses to start in production
# with the built-in development secret. Uncomment and set it in your own .env; left
# commented here so secret scanners do not read the next line as its value.
# ODDVEX_JWT_SECRET=

ODDVEX_JWT_TTL_MINUTES=60

# Comma-separated browser origins allowed by CORS.
ODDVEX_CORS_ORIGINS=http://localhost:3000

# Only set to true behind exactly one trusted proxy. The last X-Forwarded-For entry
# (the one that proxy appends) is then used as the client IP for rate limiting.
ODDVEX_TRUST_PROXY=false

# Per-IP sliding-window limits on /v1/auth/* and /v1/assistant/*.
ODDVEX_RATE_LIMIT_ENABLED=true
ODDVEX_RATE_LIMIT_AUTH_PER_MINUTE=10
ODDVEX_RATE_LIMIT_ASSISTANT_PER_MINUTE=20
ODDVEX_RATE_LIMIT_WINDOW_SECONDS=60

# Per-account limits, counted per email address (or user) whatever the IP, in memory.
# After ODDVEX_LOGIN_MAX_FAILURES failed logins for one email inside the window, further
# attempts get HTTP 429 until the window moves on. ODDVEX_EMAIL_REQUESTS_PER_WINDOW caps
# verification and password-reset emails per address in the same window.
# All of them are off when ODDVEX_RATE_LIMIT_ENABLED=false.
ODDVEX_ACCOUNT_LIMIT_WINDOW_SECONDS=900
ODDVEX_LOGIN_MAX_FAILURES=8
ODDVEX_EMAIL_REQUESTS_PER_WINDOW=3

# Password hashing (argon2id) holds about 64 MiB per operation while it runs, on top of
# about 85 MiB idle. At most ODDVEX_PASSWORD_HASH_CONCURRENCY run at once in the process
# (minimum 1); the default of 2 peaks near 215 MiB. Size it to the container's memory limit.
# A login, sign-up or password change waits up to ODDVEX_PASSWORD_HASH_WAIT_SECONDS for a
# free slot (0 = never wait), then gets HTTP 429 with Retry-After. A request turned away
# this way is not counted as a failed login. ODDVEX_RATE_LIMIT_ENABLED=false does not
# switch this off.
ODDVEX_PASSWORD_HASH_CONCURRENCY=2
ODDVEX_PASSWORD_HASH_WAIT_SECONDS=1.0

# Email. "outbox" writes messages to the email_outbox table and sends nothing; it is the
# only working value. "resend" is a stub that refuses to start the app: sending real email
# needs a paid provider and Founder approval. There is no provider key to configure.
ODDVEX_EMAIL_PROVIDER=outbox

# Base URL of the web app, used for the links in emails.
ODDVEX_WEB_BASE_URL=http://localhost:3000

# Lifetime of an email confirmation link, in hours.
ODDVEX_EMAIL_VERIFICATION_TTL_HOURS=24

# Lifetime of a password reset link, in minutes (default 60). Not a secret; left commented
# so secret scanners do not read the next line as a value for a password-like name.
# ODDVEX_PASSWORD_RESET_TTL_MINUTES=

# A quote older than this is flagged stale and excluded from best price.
ODDVEX_STALE_LIVE_SECONDS=120
ODDVEX_STALE_PREGAME_SECONDS=900

# Synthetic data generator seed.
ODDVEX_SYNTHETIC_SEED=20260101

# Data provider: "synthetic" (default) or "replay". Replay serves a real past season with REAL
# team and player names and simulated prices. Internal previews only: the API refuses to start
# with it when ODDVEX_ENV=production. See data/external/README.md for how to build the dataset.
# ODDVEX_DATA_PROVIDER=replay
# ODDVEX_REPLAY_DATA_PATH=../../data/external/replay/nfl_2024.json
# ODDVEX_REPLAY_SHIFT_DAYS=728

# Comma-separated emails that hold the admin role. This list is the only source of the role:
# a listed address gets it (once its email is confirmed, while the email_flows flag is on),
# and an address taken off the list loses it at its next login or request. In production
# email_flows is off by default, so a listed address is an administrator from registration:
# only list addresses whose owners have already registered.
# scripts/seed_demo.py creates admin@oddvex.test only if that address is listed here.
ODDVEX_ADMIN_EMAILS=

# Demo account (demo@oddvex.test). Development convenience only; ignored in production.
ODDVEX_AUTO_SEED_DEMO=false
ODDVEX_DEMO_PASSWORD=oddvex-demo-2026

# Create tables on startup. Defaults to true outside production; always off in production
# (run `alembic upgrade head` instead).
# ODDVEX_DB_AUTO_CREATE=true

ODDVEX_SYNC_MAX_ATTEMPTS=3

# Most bets one account can hold, manual and imported together. At the cap POST /v1/bets
# answers HTTP 409 (bet_limit_reached) and an import stops adding. A bet of the largest
# size (20 legs, 2,000 characters of notes) is about 22 KiB of database, so the default
# bounds one account at roughly 110 MiB.
ODDVEX_MAX_BETS_PER_USER=5000

# Per-user limits, counted per user id whatever the IP, in memory, off when
# ODDVEX_RATE_LIMIT_ENABLED=false. Bet writes (create, edit, delete, settle, auto-settle)
# and sync writes share the first two; the data export has its own. Over a limit the
# answer is HTTP 429 with Retry-After.
ODDVEX_RATE_LIMIT_USER_WRITES_PER_MINUTE=120
ODDVEX_RATE_LIMIT_USER_WRITES_PER_DAY=2000
ODDVEX_RATE_LIMIT_EXPORT_PER_HOUR=10
# Streamed responses (the bet list and the export) one user can have in progress at the
# same moment. Each holds one batch of bets while the client reads. One more is HTTP 429.
ODDVEX_RATE_LIMIT_USER_STREAMS_AT_ONCE=8

# Alerts are evaluated when a user reads their notifications, at most once per this many
# seconds per user (0 = on every read). There is no background worker; for scheduled
# evaluation run scripts/evaluate_alerts.py from cron.
ODDVEX_ALERT_EVAL_MIN_SECONDS=30

# Community (behind the "community" feature flag, which is off by default and is turned on
# with PUT /v1/admin/flags/community, not here). Per-user limits, counted in memory, off when
# ODDVEX_RATE_LIMIT_ENABLED=false.
ODDVEX_COMMUNITY_PICKS_PER_DAY=20
ODDVEX_COMMUNITY_COMMENTS_PER_HOUR=30
ODDVEX_COMMUNITY_REPORTS_PER_HOUR=10
ODDVEX_COMMUNITY_FOLLOWS_PER_HOUR=60
# Community picks are graded when someone reads the community, at most once per this many
# seconds (0 = on every read). There is no background worker; for scheduled grading run
# scripts/grade_picks.py from cron.
ODDVEX_COMMUNITY_GRADE_MIN_SECONDS=15

# Largest request body accepted, in bytes (minimum 1024). Larger requests get HTTP 413.
ODDVEX_MAX_BODY_BYTES=65536

ODDVEX_LOG_LEVEL=INFO
