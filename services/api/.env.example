# OddVex API configuration. Copy to .env for local development.
# Names and safe development defaults only. Never commit real secrets.

# development | test | production
ODDVEX_ENV=development

# SQLAlchemy URL. SQLite for local work, PostgreSQL elsewhere:
#   postgresql://user:password@host:5432/oddvex
DATABASE_URL=sqlite:///./oddvex_dev.db

# Required in production (32+ characters). The app refuses to start in production
# with the built-in development secret. Uncomment and set it in your own .env; left
# commented here so secret scanners do not read the next line as its value.
# ODDVEX_JWT_SECRET=

ODDVEX_JWT_TTL_MINUTES=60

# Comma-separated browser origins allowed by CORS.
ODDVEX_CORS_ORIGINS=http://localhost:3000

# Only set to true behind exactly one trusted proxy. The last X-Forwarded-For entry
# (the one that proxy appends) is then used as the client IP for rate limiting.
ODDVEX_TRUST_PROXY=false

# Per-IP sliding-window limits on /v1/auth/* and /v1/assistant/*.
ODDVEX_RATE_LIMIT_ENABLED=true
ODDVEX_RATE_LIMIT_AUTH_PER_MINUTE=10
ODDVEX_RATE_LIMIT_ASSISTANT_PER_MINUTE=20
ODDVEX_RATE_LIMIT_WINDOW_SECONDS=60

# A quote older than this is flagged stale and excluded from best price.
ODDVEX_STALE_LIVE_SECONDS=120
ODDVEX_STALE_PREGAME_SECONDS=900

# Synthetic data generator seed.
ODDVEX_SYNTHETIC_SEED=20260101

# Comma-separated emails that get the admin role at registration or next login.
ODDVEX_ADMIN_EMAILS=

# Demo account (demo@oddvex.test). Development convenience only; ignored in production.
ODDVEX_AUTO_SEED_DEMO=false
ODDVEX_DEMO_PASSWORD=oddvex-demo-2026

# Create tables on startup. Defaults to true outside production; always off in production
# (run `alembic upgrade head` instead).
# ODDVEX_DB_AUTO_CREATE=true

ODDVEX_SYNC_MAX_ATTEMPTS=3

# Alerts are evaluated when a user reads their notifications, at most once per this many
# seconds per user (0 = on every read). There is no background worker; for scheduled
# evaluation run scripts/evaluate_alerts.py from cron.
ODDVEX_ALERT_EVAL_MIN_SECONDS=30

# Largest request body accepted, in bytes (minimum 1024). Larger requests get HTTP 413.
ODDVEX_MAX_BODY_BYTES=65536

ODDVEX_LOG_LEVEL=INFO
